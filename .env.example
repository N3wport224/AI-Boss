# Copy to .env and export into your shell (or load with python-dotenv once you add it).
# Nothing in the boilerplate reads these yet — they're placeholders for the first
# real agent/workflow module that needs them.

ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///orchestrator.db
LOG_LEVEL=INFO

# Optional data-location overrides. Each defaults to the repo-root path shown;
# the test suite sets all five to a throwaway temp directory so tests never
# touch (or race against) a live server's real data.
# AIBOSS_DB_PATH=orchestrator.db
# AIBOSS_ARTIFACTS_DIR=artifacts
# AIBOSS_WATCH_DIR=watched_input
# AIBOSS_BACKUPS_DIR=backups
# AIBOSS_PIPELINES_DIR=pipelines
